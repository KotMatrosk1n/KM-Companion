<!-- SPDX-License-Identifier: MIT -->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:bal="http://wixtoolset.org/schemas/v4/wxs/bal"
     xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util">
  <Bundle Name="KM Companion"
          InProgressName="KM Companion Setup"
          Manufacturer="Matroskin"
          Version="$(var.KmVersion)"
          UpgradeCode="6fec009c-ac8f-45c2-b84b-a648204cd665"
          ProviderKey="com.kotmatrosk1n.kmcalculator.bundle"
          IconSourceFile="$(var.KmIconPath)"
          Copyright="Copyright 2026 Matroskin"
          AboutUrl="https://github.com/KotMatrosk1n/KM-Companion"
          HelpUrl="https://github.com/KotMatrosk1n/KM-Companion/issues"
          DisableModify="no"
          DisableRemove="no"
          Compressed="yes"
          bal:CommandLineVariables="caseInsensitive">
    <Log Prefix="KM-Companion-Setup" />

    <Variable Name="InstallFolder"
              Type="formatted"
              Value="[ProgramFiles64Folder]KM Companion\" />
    <!-- The existing MSI family upgrades the former product from its original canonical path. -->
    <Variable Name="PreviousInstallFolder"
              Type="formatted"
              Value="[ProgramFiles64Folder]KM Calculator\" />
    <Variable Name="KMCreateDesktopShortcut" Type="numeric" Value="1" bal:Overridable="yes" />
    <Variable Name="KMCreateStartMenuShortcut" Type="numeric" Value="1" bal:Overridable="yes" />
    <Variable Name="KMUpdaterInvocation" Type="numeric" Value="0" bal:Overridable="yes" />
    <Variable Name="KMRelaunchAfterInstall" Type="numeric" Value="0" bal:Overridable="yes" />
    <Variable Name="KMRemoveLegacy" Type="numeric" Value="0" Hidden="yes" bal:Overridable="yes" />
    <Variable Name="KMLegacyCleanupReceipt" Type="string" Value="" Hidden="yes" bal:Overridable="yes" />
    <Variable Name="KMLegacyCleanupOwnerSid" Type="string" Value="" Hidden="yes" bal:Overridable="yes" />
    <Variable Name="LegacyCefRoyalPayloadValidated" Type="numeric" Value="0" />
    <Variable Name="LegacyCefPokemonPayloadValidated" Type="numeric" Value="0" />
    <Variable Name="LegacyCefRoyalCanonicalValidated" Type="numeric" Value="0" />
    <Variable Name="LegacyCefPokemonCanonicalValidated" Type="numeric" Value="0" />
    <Variable Name="LegacyCefRoyalAtPokemonValidated" Type="numeric" Value="0" />
    <Variable Name="LegacyCefRoyalNestedValidated" Type="numeric" Value="0" />
    <Variable Name="LegacyCefValidated" Type="numeric" Value="0" />
    <!-- Conditions compare formatted variables, never bracketed path literals. -->
    <Variable Name="LegacyCefRoyalCanonicalRoot" Type="formatted"
              Value="[ProgramFiles64Folder]Royal Sword Calculator" />
    <Variable Name="LegacyCefPokemonCanonicalRoot" Type="formatted"
              Value="[ProgramFiles64Folder]Pokemon Royal Sword" />
    <Variable Name="LegacyCefRoyalNestedRoot" Type="formatted"
              Value="[ProgramFiles64Folder]Pokemon Royal Sword\Royal Sword Calculator" />
    <Variable Name="LegacyCefRoyalCanonicalUninstallCommand"
              Type="formatted"
              Value="&quot;[ProgramFiles64Folder]Royal Sword Calculator\Uninstall Royal Sword Calculator.exe&quot; /allusers" />
    <Variable Name="LegacyCefPokemonCanonicalUninstallCommand"
              Type="formatted"
              Value="&quot;[ProgramFiles64Folder]Pokemon Royal Sword\Uninstall Pokemon Royal Sword.exe&quot; /allusers" />
    <Variable Name="LegacyCefRoyalAtPokemonUninstallCommand"
              Type="formatted"
              Value="&quot;[ProgramFiles64Folder]Pokemon Royal Sword\Uninstall Royal Sword Calculator.exe&quot; /allusers" />
    <Variable Name="LegacyCefRoyalNestedUninstallCommand"
              Type="formatted"
              Value="&quot;[ProgramFiles64Folder]Pokemon Royal Sword\Royal Sword Calculator\Uninstall Royal Sword Calculator.exe&quot; /allusers" />

    <util:RegistrySearch Id="ExistingKmMarkerPresentSearch"
                         Root="HKLM"
                         Key="Software\KM Calculator"
                         Variable="ExistingKmMarkerPresent"
                         Result="exists"
                         Bitness="always64" />
    <util:RegistrySearch Id="ExistingInstallLocationSearch"
                         After="ExistingKmMarkerPresentSearch"
                         Root="HKLM"
                         Key="Software\KM Calculator"
                         Value="InstallLocation"
                         Variable="ExistingInstallLocation"
                         Result="value"
                         Bitness="always64" />
    <util:RegistrySearch Id="ExistingDesktopPreferenceSearch"
                         After="ExistingInstallLocationSearch"
                         Root="HKLM"
                         Key="Software\KM Calculator"
                         Value="CreateDesktopShortcut"
                         Variable="KMCreateDesktopShortcut"
                         Result="value"
                         Bitness="always64" />
    <util:RegistrySearch Id="ExistingStartMenuPreferenceSearch"
                         After="ExistingDesktopPreferenceSearch"
                         Root="HKLM"
                         Key="Software\KM Calculator"
                         Value="CreateStartMenuShortcut"
                         Variable="KMCreateStartMenuShortcut"
                         Result="value"
                         Bitness="always64" />

    <util:DirectorySearch Id="LegacyCefRoyalCanonicalRootPresentSearch"
                         After="ExistingStartMenuPreferenceSearch"
                         Path="[ProgramFiles64Folder]Royal Sword Calculator"
                         Variable="LegacyCefRoyalCanonicalRootPresent"
                         Result="exists"
                         DisableFileRedirection="yes" />
    <util:DirectorySearch Id="LegacyCefPokemonCanonicalRootPresentSearch"
                         After="LegacyCefRoyalCanonicalRootPresentSearch"
                         Path="[ProgramFiles64Folder]Pokemon Royal Sword"
                         Variable="LegacyCefPokemonCanonicalRootPresent"
                         Result="exists"
                         DisableFileRedirection="yes" />
    <util:DirectorySearch Id="LegacyCefRoyalNestedRootPresentSearch"
                         After="LegacyCefPokemonCanonicalRootPresentSearch"
                         Path="[ProgramFiles64Folder]Pokemon Royal Sword\Royal Sword Calculator"
                         Variable="LegacyCefRoyalNestedRootPresent"
                         Result="exists"
                         DisableFileRedirection="yes" />
    <util:RegistrySearch Id="LegacyCefProductKeyPresentSearch"
                         After="LegacyCefRoyalNestedRootPresentSearch"
                         Root="HKLM"
                         Key="Software\cef17072-1d18-5c82-9672-1f987b4e4970"
                         Variable="LegacyCefProductKeyPresent"
                         Result="exists"
                         Bitness="always64" />
    <util:RegistrySearch Id="LegacyCefArpKeyPresentSearch"
                         After="LegacyCefProductKeyPresentSearch"
                         Root="HKLM"
                         Key="Software\Microsoft\Windows\CurrentVersion\Uninstall\cef17072-1d18-5c82-9672-1f987b4e4970"
                         Variable="LegacyCefArpKeyPresent"
                         Result="exists"
                         Bitness="always64" />
    <util:RegistrySearch Id="LegacyCefLocationSearch"
                         After="LegacyCefArpKeyPresentSearch"
                         Root="HKLM"
                         Key="Software\cef17072-1d18-5c82-9672-1f987b4e4970"
                         Value="InstallLocation"
                         Variable="LegacyCefInstallLocation"
                         Result="value"
                         Bitness="always64" />
    <util:RegistrySearch Id="LegacyCefDisplayNameSearch"
                         After="LegacyCefLocationSearch"
                         Root="HKLM"
                         Key="Software\Microsoft\Windows\CurrentVersion\Uninstall\cef17072-1d18-5c82-9672-1f987b4e4970"
                         Value="DisplayName"
                         Variable="LegacyCefDisplayName"
                         Result="value"
                         Bitness="always64" />
    <util:RegistrySearch Id="LegacyCefPublisherSearch"
                         After="LegacyCefDisplayNameSearch"
                         Root="HKLM"
                         Key="Software\Microsoft\Windows\CurrentVersion\Uninstall\cef17072-1d18-5c82-9672-1f987b4e4970"
                         Value="Publisher"
                         Variable="LegacyCefPublisher"
                         Result="value"
                         Bitness="always64" />
    <util:RegistrySearch Id="LegacyCefVersionSearch"
                         After="LegacyCefPublisherSearch"
                         Root="HKLM"
                         Key="Software\Microsoft\Windows\CurrentVersion\Uninstall\cef17072-1d18-5c82-9672-1f987b4e4970"
                         Value="DisplayVersion"
                         Variable="LegacyCefDisplayVersion"
                         Result="value"
                         Bitness="always64" />
    <util:RegistrySearch Id="LegacyCefUninstallCommandSearch"
                         After="LegacyCefVersionSearch"
                         Root="HKLM"
                         Key="Software\Microsoft\Windows\CurrentVersion\Uninstall\cef17072-1d18-5c82-9672-1f987b4e4970"
                         Value="UninstallString"
                         Variable="LegacyCefUninstallCommand"
                         Result="value"
                         Bitness="always64" />
    <util:FileSearch Id="LegacyCefRoyalExecutableSearch"
                       After="LegacyCefUninstallCommandSearch"
                      Path="[LegacyCefInstallLocation]\Royal Sword Calculator.exe"
                      Variable="LegacyCefRoyalExecutableVersion"
                      Result="version"
                      DisableFileRedirection="yes" />
    <util:FileSearch Id="LegacyCefPokemonExecutableSearch"
                      After="LegacyCefRoyalExecutableSearch"
                      Path="[LegacyCefInstallLocation]\Pokemon Royal Sword.exe"
                      Variable="LegacyCefPokemonExecutableVersion"
                      Result="version"
                      DisableFileRedirection="yes" />
    <util:FileSearch Id="LegacyCefRoyalUninstallerSearch"
                      After="LegacyCefPokemonExecutableSearch"
                      Path="[LegacyCefInstallLocation]\Uninstall Royal Sword Calculator.exe"
                      Variable="LegacyCefRoyalUninstallerVersion"
                      Result="version"
                      DisableFileRedirection="yes" />
    <util:FileSearch Id="LegacyCefPokemonUninstallerSearch"
                      After="LegacyCefRoyalUninstallerSearch"
                      Path="[LegacyCefInstallLocation]\Uninstall Pokemon Royal Sword.exe"
                      Variable="LegacyCefPokemonUninstallerVersion"
                      Result="version"
                      DisableFileRedirection="yes" />
    <util:FileSearch Id="LegacyCefAppArchiveSearch"
                      After="LegacyCefPokemonUninstallerSearch"
                     Path="[LegacyCefInstallLocation]\resources\app.asar"
                     Variable="LegacyCefAppArchiveExists"
                     Result="exists"
                     DisableFileRedirection="yes" />
    <util:FileSearch Id="LegacyCefUpdaterConfigSearch"
                     After="LegacyCefAppArchiveSearch"
                     Path="[LegacyCefInstallLocation]\resources\app-update.yml"
                     Variable="LegacyCefUpdaterConfigExists"
                     Result="exists"
                     DisableFileRedirection="yes" />
    <util:FileSearch Id="LegacyCefSpriteManifestSearch"
                     After="LegacyCefUpdaterConfigSearch"
                     Path="[LegacyCefInstallLocation]\resources\sprites\manifest.json"
                     Variable="LegacyCefSpriteManifestExists"
                     Result="exists"
                     DisableFileRedirection="yes" />
    <SetVariable Id="ValidateLegacyCefRoyalPayload"
                  After="LegacyCefSpriteManifestSearch"
                  Variable="LegacyCefRoyalPayloadValidated"
                  Value="1"
                  Type="numeric"
                  Condition="LegacyCefDisplayName = &quot;Royal Sword Calculator&quot; AND LegacyCefAppArchiveExists AND LegacyCefUpdaterConfigExists AND ((LegacyCefPublisher = &quot;KotMatrosk1n&quot; AND ((LegacyCefDisplayVersion = &quot;0.1.3&quot; AND LegacyCefRoyalExecutableVersion = v42.3.3.0 AND LegacyCefRoyalUninstallerVersion = v0.1.3.0) OR (LegacyCefDisplayVersion = &quot;0.1.4&quot; AND LegacyCefRoyalExecutableVersion = v42.3.3.0 AND LegacyCefRoyalUninstallerVersion = v0.1.4.0) OR (LegacyCefDisplayVersion = &quot;0.1.5&quot; AND LegacyCefRoyalExecutableVersion = v42.3.3.0 AND LegacyCefRoyalUninstallerVersion = v0.1.5.0) OR (LegacyCefDisplayVersion = &quot;0.1.6&quot; AND LegacyCefRoyalExecutableVersion = v42.3.3.0 AND LegacyCefRoyalUninstallerVersion = v0.1.6.0) OR (LegacyCefDisplayVersion = &quot;0.1.7&quot; AND LegacyCefRoyalExecutableVersion = v0.1.7.0 AND LegacyCefRoyalUninstallerVersion = v0.1.7.0) OR (LegacyCefDisplayVersion = &quot;0.1.8&quot; AND LegacyCefRoyalExecutableVersion = v0.1.8.0 AND LegacyCefRoyalUninstallerVersion = v0.1.8.0 AND LegacyCefSpriteManifestExists) OR (LegacyCefDisplayVersion = &quot;0.1.9&quot; AND LegacyCefRoyalExecutableVersion = v0.1.9.0 AND LegacyCefRoyalUninstallerVersion = v0.1.9.0 AND LegacyCefSpriteManifestExists) OR (LegacyCefDisplayVersion = &quot;0.2.0&quot; AND LegacyCefRoyalExecutableVersion = v0.2.0.0 AND LegacyCefRoyalUninstallerVersion = v0.2.0.0 AND LegacyCefSpriteManifestExists))) OR (LegacyCefPublisher = &quot;Matroskin&quot; AND ((LegacyCefDisplayVersion = &quot;0.2.1&quot; AND LegacyCefRoyalExecutableVersion = v0.2.1.0 AND LegacyCefRoyalUninstallerVersion = v0.2.1.0 AND LegacyCefSpriteManifestExists) OR (LegacyCefDisplayVersion = &quot;0.2.2&quot; AND LegacyCefRoyalExecutableVersion = v0.2.2.0 AND LegacyCefRoyalUninstallerVersion = v0.2.2.0 AND LegacyCefSpriteManifestExists) OR (LegacyCefDisplayVersion = &quot;0.3.21&quot; AND LegacyCefRoyalExecutableVersion = v0.3.21.0 AND LegacyCefRoyalUninstallerVersion = v0.3.21.0 AND LegacyCefSpriteManifestExists) OR (LegacyCefDisplayVersion = &quot;0.4.26&quot; AND LegacyCefRoyalExecutableVersion = v0.4.26.0 AND LegacyCefRoyalUninstallerVersion = v0.4.26.0 AND LegacyCefSpriteManifestExists))))" />
    <SetVariable Id="ValidateLegacyCefPokemonPayload"
                  After="ValidateLegacyCefRoyalPayload"
                  Variable="LegacyCefPokemonPayloadValidated"
                  Value="1"
                  Type="numeric"
                  Condition="LegacyCefPublisher = &quot;KotMatrosk1n&quot; AND LegacyCefPokemonExecutableVersion = v42.3.3.0 AND LegacyCefAppArchiveExists AND LegacyCefUpdaterConfigExists AND ((LegacyCefDisplayName = &quot;Pokemon Royal Sword 0.1.0&quot; AND LegacyCefDisplayVersion = &quot;0.1.0&quot; AND LegacyCefPokemonUninstallerVersion = v0.1.0.0) OR (LegacyCefDisplayName = &quot;Pokemon Royal Sword 0.1.1&quot; AND LegacyCefDisplayVersion = &quot;0.1.1&quot; AND LegacyCefPokemonUninstallerVersion = v0.1.1.0) OR (LegacyCefDisplayName = &quot;Pokemon Royal Sword 0.1.2&quot; AND LegacyCefDisplayVersion = &quot;0.1.2&quot; AND LegacyCefPokemonUninstallerVersion = v0.1.2.0))" />
    <SetVariable Id="ValidateLegacyCefRoyalCanonical"
                  After="ValidateLegacyCefPokemonPayload"
                  Variable="LegacyCefRoyalCanonicalValidated"
                  Value="1"
                  Type="numeric"
                  Condition="LegacyCefRoyalPayloadValidated = 1 AND LegacyCefInstallLocation ~= LegacyCefRoyalCanonicalRoot AND LegacyCefUninstallCommand ~= LegacyCefRoyalCanonicalUninstallCommand" />
    <SetVariable Id="ValidateLegacyCefPokemonCanonical"
                  After="ValidateLegacyCefRoyalCanonical"
                  Variable="LegacyCefPokemonCanonicalValidated"
                  Value="1"
                  Type="numeric"
                  Condition="LegacyCefPokemonPayloadValidated = 1 AND LegacyCefInstallLocation ~= LegacyCefPokemonCanonicalRoot AND LegacyCefUninstallCommand ~= LegacyCefPokemonCanonicalUninstallCommand" />
    <SetVariable Id="ValidateLegacyCefRoyalAtPokemon"
                  After="ValidateLegacyCefPokemonCanonical"
                  Variable="LegacyCefRoyalAtPokemonValidated"
                  Value="1"
                  Type="numeric"
                  Condition="LegacyCefRoyalPayloadValidated = 1 AND LegacyCefInstallLocation ~= LegacyCefPokemonCanonicalRoot AND LegacyCefUninstallCommand ~= LegacyCefRoyalAtPokemonUninstallCommand" />
    <SetVariable Id="ValidateLegacyCefRoyalNested"
                  After="ValidateLegacyCefRoyalAtPokemon"
                  Variable="LegacyCefRoyalNestedValidated"
                  Value="1"
                  Type="numeric"
                  Condition="LegacyCefRoyalPayloadValidated = 1 AND LegacyCefInstallLocation ~= LegacyCefRoyalNestedRoot AND LegacyCefUninstallCommand ~= LegacyCefRoyalNestedUninstallCommand" />
    <SetVariable Id="ValidateLegacyCefInstall"
                  After="ValidateLegacyCefRoyalNested"
                  Variable="LegacyCefValidated"
                  Value="1"
                  Type="numeric"
                  Condition="LegacyCefRoyalCanonicalValidated = 1 OR LegacyCefPokemonCanonicalValidated = 1 OR LegacyCefRoyalAtPokemonValidated = 1 OR LegacyCefRoyalNestedValidated = 1" />

    <bal:Condition Condition="WixBundleInstalled OR NOT ExistingKmMarkerPresent OR (ExistingInstallLocation AND (ExistingInstallLocation ~= InstallFolder OR ExistingInstallLocation ~= PreviousInstallFolder))"
                   Message="An existing installation was detected outside the supported Program Files\KM Companion or Program Files\KM Calculator folder. Uninstall that copy first, then run setup again." />
    <bal:Condition Condition="NOT KMRemoveLegacy OR (NOT LegacyCefRoyalCanonicalRootPresent AND NOT LegacyCefPokemonCanonicalRootPresent AND NOT LegacyCefRoyalNestedRootPresent AND NOT LegacyCefProductKeyPresent AND NOT LegacyCefArpKeyPresent) OR (LegacyCefValidated = 1 AND (NOT LegacyCefRoyalCanonicalRootPresent OR LegacyCefRoyalCanonicalValidated = 1) AND (NOT LegacyCefPokemonCanonicalRootPresent OR LegacyCefPokemonCanonicalValidated = 1 OR LegacyCefRoyalAtPokemonValidated = 1 OR LegacyCefRoyalNestedValidated = 1) AND (NOT LegacyCefRoyalNestedRootPresent OR LegacyCefRoyalNestedValidated = 1))"
                   Message="A Royal Sword Calculator installation or leftover program folder was detected but cannot be removed safely. Uninstall Royal Sword Calculator from Windows Settings, or remove its leftover Program Files folder if it is no longer registered, then run KM Companion Setup again. After KM Companion installs successfully, setup removes the remaining Royal Sword Calculator data for the current Windows user." />

    <BootstrapperApplication SourceFile="$(var.KmSetupUiDir)\KMCompanion.Setup.UI.exe">
      <Payloads Include="$(var.KmSetupUiDir)\**">
        <Exclude Files="$(var.KmSetupUiDir)\KMCompanion.Setup.UI.exe" />
        <Exclude Files="$(var.KmSetupUiDir)\**\*.pdb" />
      </Payloads>
    </BootstrapperApplication>

    <Chain>
      <MsiPackage Id="KmCalculatorMsi"
                  SourceFile="$(var.KmMsiPath)"
                  Visible="no"
                  Vital="yes"
                  Cache="keep"
                  bal:DisplayFilesInUseDialogCondition="1">
        <MsiProperty Name="INSTALLFOLDER" Value="[InstallFolder]" />
        <MsiProperty Name="KM_CREATE_DESKTOP_SHORTCUT" Value="[KMCreateDesktopShortcut]" />
        <MsiProperty Name="KM_CREATE_START_MENU_SHORTCUT" Value="[KMCreateStartMenuShortcut]" />
        <MsiProperty Name="KM_LEGACY_CEF_VALID" Value="[LegacyCefValidated]" />
        <MsiProperty Name="KM_REMOVE_LEGACY" Value="1" Condition="WixBundleAction = 6 AND KMRemoveLegacy" />
        <MsiProperty Name="KM_LEGACY_CLEANUP_RECEIPT" Value="[KMLegacyCleanupReceipt]"
                     Condition="WixBundleAction = 6 AND KMLegacyCleanupReceipt" />
        <MsiProperty Name="KM_LEGACY_CLEANUP_OWNER_SID" Value="[KMLegacyCleanupOwnerSid]"
                     Condition="WixBundleAction = 6 AND KMLegacyCleanupReceipt AND KMLegacyCleanupOwnerSid" />
      </MsiPackage>
    </Chain>
  </Bundle>
</Wix>
