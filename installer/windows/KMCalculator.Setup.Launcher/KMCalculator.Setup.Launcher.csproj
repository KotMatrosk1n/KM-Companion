<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <PublishTrimmed>false</PublishTrimmed>
    <PublishReadyToRun>false</PublishReadyToRun>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>KM-Companion-Setup</AssemblyName>
    <RootNamespace>KMCalculator.Setup.Launcher</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>$(KmIconPath)</ApplicationIcon>
    <Version>$(KmVersion)</Version>
    <FileVersion>$(KmVersion).0</FileVersion>
    <AssemblyVersion>$(KmVersion).0</AssemblyVersion>
    <InformationalVersion>$(KmVersion)</InformationalVersion>
    <Company>Matroskin</Company>
    <Product>KM Companion Setup</Product>
    <Description>KM Companion Windows setup launcher</Description>
    <Copyright>Copyright 2026 Matroskin</Copyright>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="$(KmInnerBundlePath)" LogicalName="KMCalculator.Setup.InnerBundle" />
    <EmbeddedResource Include="$(KmInnerBundleSha256File)" LogicalName="KMCalculator.Setup.InnerBundleSha256" />
    <EmbeddedResource Include="$(KmVersionFile)" LogicalName="KMCalculator.Setup.Version" />
  </ItemGroup>

  <Target Name="ValidateKmLauncherInputs" BeforeTargets="PrepareForBuild">
    <Error Condition="'$(KmVersion)' == ''" Text="KmVersion is required." />
    <Error Condition="!Exists('$(KmIconPath)')" Text="KmIconPath does not exist: $(KmIconPath)" />
    <Error Condition="!Exists('$(KmInnerBundlePath)')" Text="KmInnerBundlePath does not exist: $(KmInnerBundlePath)" />
    <Error Condition="!Exists('$(KmInnerBundleSha256File)')" Text="KmInnerBundleSha256File does not exist: $(KmInnerBundleSha256File)" />
    <Error Condition="!Exists('$(KmVersionFile)')" Text="KmVersionFile does not exist: $(KmVersionFile)" />
  </Target>
</Project>
