    <SetProperty Action="SetKmLegacyCefRoyalRoot"
                 Id="KmLegacyCefRoyalRoot"
                 Value="[ProgramFiles64Folder]Royal Sword Calculator"
                 Sequence="execute"
                 After="AppSearch" />
    <SetProperty Action="SetKmLegacyCefPokemonRoot"
                 Id="KmLegacyCefPokemonRoot"
                 Value="[ProgramFiles64Folder]Pokemon Royal Sword"
                 Sequence="execute"
                 After="SetKmLegacyCefRoyalRoot" />
    <SetProperty Action="SetKmLegacyCefRoyalNestedRoot"
                 Id="KmLegacyCefRoyalNestedRoot"
                 Value="[ProgramFiles64Folder]Pokemon Royal Sword\Royal Sword Calculator"
                 Sequence="execute"
                 After="SetKmLegacyCefPokemonRoot" />
    <SetProperty Action="SetKmLegacyCefRoyalCanonicalUninstallCommand"
                 Id="KmLegacyCefRoyalCanonicalUninstallCommand"
                 Value="&quot;[ProgramFiles64Folder]Royal Sword Calculator\Uninstall Royal Sword Calculator.exe&quot; /allusers"
                 Sequence="execute"
                 After="SetKmLegacyCefRoyalNestedRoot" />
    <SetProperty Action="SetKmLegacyCefPokemonCanonicalUninstallCommand"
                 Id="KmLegacyCefPokemonCanonicalUninstallCommand"
                 Value="&quot;[ProgramFiles64Folder]Pokemon Royal Sword\Uninstall Pokemon Royal Sword.exe&quot; /allusers"
                 Sequence="execute"
                 After="SetKmLegacyCefRoyalCanonicalUninstallCommand" />
    <SetProperty Action="SetKmLegacyCefRoyalAtPokemonUninstallCommand"
                 Id="KmLegacyCefRoyalAtPokemonUninstallCommand"
                 Value="&quot;[ProgramFiles64Folder]Pokemon Royal Sword\Uninstall Royal Sword Calculator.exe&quot; /allusers"
                 Sequence="execute"
                 After="SetKmLegacyCefPokemonCanonicalUninstallCommand" />
    <SetProperty Action="SetKmLegacyCefRoyalNestedUninstallCommand"
                 Id="KmLegacyCefRoyalNestedUninstallCommand"
                 Value="&quot;[ProgramFiles64Folder]Pokemon Royal Sword\Royal Sword Calculator\Uninstall Royal Sword Calculator.exe&quot; /allusers"
                 Sequence="execute"
                 After="SetKmLegacyCefRoyalAtPokemonUninstallCommand" />
    <!-- Split validation into ordered private flags to fit MSI condition columns. -->
    <SetProperty Action="ValidateKmLegacyRoyalBase"
                 Id="KmLegacyRoyalBaseValid"
                 Value="1"
                 Sequence="execute"
                 After="SetKmLegacyCefRoyalNestedUninstallCommand"
                 Condition="KM_REMOVE_LEGACY = 1 AND KM_LEGACY_CEF_VALID = 1 AND KMLEGACYCEFDISPLAYNAME = &quot;Royal Sword Calculator&quot; AND KMLEGACYCEFAPPARCHIVE AND KMLEGACYCEFUPDATERCONFIG" />
    <SetProperty Action="ValidateKmLegacyRoyalKotBase"
                 Id="KmLegacyRoyalKotBaseValid"
                 Value="1"
                 Sequence="execute"
                 After="ValidateKmLegacyRoyalBase"
                 Condition="KmLegacyRoyalBaseValid = 1 AND KMLEGACYCEFPUBLISHER = &quot;KotMatrosk1n&quot;" />
    <SetProperty Action="ValidateKmLegacyRoyalMatroskinBase"
                 Id="KmLegacyRoyalMatroskinBaseValid"
                 Value="1"
                 Sequence="execute"
                 After="ValidateKmLegacyRoyalKotBase"
                 Condition="KmLegacyRoyalBaseValid = 1 AND KMLEGACYCEFPUBLISHER = &quot;Matroskin&quot;" />
    <SetProperty Action="ValidateKmLegacyRoyal013"
                 Id="KmLegacyCefRoyalPayloadValidated"
                 Value="1"
                 Sequence="execute"
                 After="ValidateKmLegacyRoyalMatroskinBase"
                 Condition="KmLegacyRoyalKotBaseValid = 1 AND KMLEGACYCEFDISPLAYVERSION = &quot;0.1.3&quot; AND KMLEGACYROYALMAINELECTRON AND KMLEGACYROYALUNINSTALL013" />
    <SetProperty Action="ValidateKmLegacyRoyal014"
                 Id="KmLegacyCefRoyalPayloadValidated"
                 Value="1"
                 Sequence="execute"
                 After="ValidateKmLegacyRoyal013"
                 Condition="KmLegacyRoyalKotBaseValid = 1 AND KMLEGACYCEFDISPLAYVERSION = &quot;0.1.4&quot; AND KMLEGACYROYALMAINELECTRON AND KMLEGACYROYALUNINSTALL014" />
    <SetProperty Action="ValidateKmLegacyRoyal015"
                 Id="KmLegacyCefRoyalPayloadValidated"
                 Value="1"
                 Sequence="execute"
                 After="ValidateKmLegacyRoyal014"
                 Condition="KmLegacyRoyalKotBaseValid = 1 AND KMLEGACYCEFDISPLAYVERSION = &quot;0.1.5&quot; AND KMLEGACYROYALMAINELECTRON AND KMLEGACYROYALUNINSTALL015" />
    <SetProperty Action="ValidateKmLegacyRoyal016"
                 Id="KmLegacyCefRoyalPayloadValidated"
                 Value="1"
                 Sequence="execute"
                 After="ValidateKmLegacyRoyal015"
                 Condition="KmLegacyRoyalKotBaseValid = 1 AND KMLEGACYCEFDISPLAYVERSION = &quot;0.1.6&quot; AND KMLEGACYROYALMAINELECTRON AND KMLEGACYROYALUNINSTALL016" />
    <SetProperty Action="ValidateKmLegacyRoyal017"
                 Id="KmLegacyCefRoyalPayloadValidated"
                 Value="1"
                 Sequence="execute"
                 After="ValidateKmLegacyRoyal016"
                 Condition="KmLegacyRoyalKotBaseValid = 1 AND KMLEGACYCEFDISPLAYVERSION = &quot;0.1.7&quot; AND KMLEGACYROYALMAIN017 AND KMLEGACYROYALUNINSTALL017" />
    <SetProperty Action="ValidateKmLegacyRoyal018"
                 Id="KmLegacyCefRoyalPayloadValidated"
                 Value="1"
                 Sequence="execute"
                 After="ValidateKmLegacyRoyal017"
                 Condition="KmLegacyRoyalKotBaseValid = 1 AND KMLEGACYCEFDISPLAYVERSION = &quot;0.1.8&quot; AND KMLEGACYROYALMAIN018 AND KMLEGACYROYALUNINSTALL018 AND KMLEGACYCEFSPRITEMANIFEST" />
    <SetProperty Action="ValidateKmLegacyRoyal019"
                 Id="KmLegacyCefRoyalPayloadValidated"
                 Value="1"
                 Sequence="execute"
                 After="ValidateKmLegacyRoyal018"
                 Condition="KmLegacyRoyalKotBaseValid = 1 AND KMLEGACYCEFDISPLAYVERSION = &quot;0.1.9&quot; AND KMLEGACYROYALMAIN019 AND KMLEGACYROYALUNINSTALL019 AND KMLEGACYCEFSPRITEMANIFEST" />
    <SetProperty Action="ValidateKmLegacyRoyal020"
                 Id="KmLegacyCefRoyalPayloadValidated"
                 Value="1"
                 Sequence="execute"
                 After="ValidateKmLegacyRoyal019"
                 Condition="KmLegacyRoyalKotBaseValid = 1 AND KMLEGACYCEFDISPLAYVERSION = &quot;0.2.0&quot; AND KMLEGACYROYALMAIN020 AND KMLEGACYROYALUNINSTALL020 AND KMLEGACYCEFSPRITEMANIFEST" />
    <SetProperty Action="ValidateKmLegacyRoyal021"
                 Id="KmLegacyCefRoyalPayloadValidated"
                 Value="1"
                 Sequence="execute"
                 After="ValidateKmLegacyRoyal020"
                 Condition="KmLegacyRoyalMatroskinBaseValid = 1 AND KMLEGACYCEFDISPLAYVERSION = &quot;0.2.1&quot; AND KMLEGACYROYALMAIN021 AND KMLEGACYROYALUNINSTALL021 AND KMLEGACYCEFSPRITEMANIFEST" />
    <SetProperty Action="ValidateKmLegacyRoyal022"
                 Id="KmLegacyCefRoyalPayloadValidated"
                 Value="1"
                 Sequence="execute"
                 After="ValidateKmLegacyRoyal021"
                 Condition="KmLegacyRoyalMatroskinBaseValid = 1 AND KMLEGACYCEFDISPLAYVERSION = &quot;0.2.2&quot; AND KMLEGACYROYALMAIN022 AND KMLEGACYROYALUNINSTALL022 AND KMLEGACYCEFSPRITEMANIFEST" />
    <SetProperty Action="ValidateKmLegacyRoyal0321"
                 Id="KmLegacyCefRoyalPayloadValidated"
                 Value="1"
                 Sequence="execute"
                 After="ValidateKmLegacyRoyal022"
                 Condition="KmLegacyRoyalMatroskinBaseValid = 1 AND KMLEGACYCEFDISPLAYVERSION = &quot;0.3.21&quot; AND KMLEGACYROYALMAIN0321 AND KMLEGACYROYALUNINSTALL0321 AND KMLEGACYCEFSPRITEMANIFEST" />
    <SetProperty Action="ValidateKmLegacyRoyal0426"
                 Id="KmLegacyCefRoyalPayloadValidated"
                 Value="1"
                 Sequence="execute"
                 After="ValidateKmLegacyRoyal0321"
                 Condition="KmLegacyRoyalMatroskinBaseValid = 1 AND KMLEGACYCEFDISPLAYVERSION = &quot;0.4.26&quot; AND KMLEGACYROYALMAIN0426 AND KMLEGACYROYALUNINSTALL0426 AND KMLEGACYCEFSPRITEMANIFEST" />
    <SetProperty Action="ValidateKmLegacyPokemonBase"
                 Id="KmLegacyPokemonBaseValid"
                 Value="1"
                 Sequence="execute"
                 After="ValidateKmLegacyRoyal0426"
                 Condition="KM_REMOVE_LEGACY = 1 AND KM_LEGACY_CEF_VALID = 1 AND KMLEGACYCEFPUBLISHER = &quot;KotMatrosk1n&quot; AND KMLEGACYPOKEMONMAINELECTRON AND KMLEGACYCEFAPPARCHIVE AND KMLEGACYCEFUPDATERCONFIG" />
    <SetProperty Action="ValidateKmLegacyPokemon010"
                 Id="KmLegacyCefPokemonPayloadValidated"
                 Value="1"
                 Sequence="execute"
                 After="ValidateKmLegacyPokemonBase"
                 Condition="KmLegacyPokemonBaseValid = 1 AND KMLEGACYCEFDISPLAYNAME = &quot;Pokemon Royal Sword 0.1.0&quot; AND KMLEGACYCEFDISPLAYVERSION = &quot;0.1.0&quot; AND KMLEGACYPOKEMONUNINSTALL010" />
    <SetProperty Action="ValidateKmLegacyPokemon011"
                 Id="KmLegacyCefPokemonPayloadValidated"
                 Value="1"
                 Sequence="execute"
                 After="ValidateKmLegacyPokemon010"
                 Condition="KmLegacyPokemonBaseValid = 1 AND KMLEGACYCEFDISPLAYNAME = &quot;Pokemon Royal Sword 0.1.1&quot; AND KMLEGACYCEFDISPLAYVERSION = &quot;0.1.1&quot; AND KMLEGACYPOKEMONUNINSTALL011" />
    <SetProperty Action="ValidateKmLegacyPokemon012"
                 Id="KmLegacyCefPokemonPayloadValidated"
                 Value="1"
                 Sequence="execute"
                 After="ValidateKmLegacyPokemon011"
                 Condition="KmLegacyPokemonBaseValid = 1 AND KMLEGACYCEFDISPLAYNAME = &quot;Pokemon Royal Sword 0.1.2&quot; AND KMLEGACYCEFDISPLAYVERSION = &quot;0.1.2&quot; AND KMLEGACYPOKEMONUNINSTALL012" />
    <SetProperty Action="ValidateKmLegacyCefRoyalIdentity"
                 Id="KmLegacyCefRoyalIdentityValidated"
                 Value="1"
                 Sequence="execute"
                 After="ValidateKmLegacyPokemon012"
                 Condition="KmLegacyCefRoyalPayloadValidated = 1 AND KMLEGACYCEFINSTALLLOCATION ~= KmLegacyCefRoyalRoot AND KMLEGACYCEFUNINSTALLCOMMAND ~= KmLegacyCefRoyalCanonicalUninstallCommand" />
    <SetProperty Action="ValidateKmLegacyCefPokemonIdentity"
                 Id="KmLegacyCefPokemonIdentityValidated"
                 Value="1"
                 Sequence="execute"
                 After="ValidateKmLegacyCefRoyalIdentity"
                 Condition="KmLegacyCefPokemonPayloadValidated = 1 AND KMLEGACYCEFINSTALLLOCATION ~= KmLegacyCefPokemonRoot AND KMLEGACYCEFUNINSTALLCOMMAND ~= KmLegacyCefPokemonCanonicalUninstallCommand" />
    <SetProperty Action="ValidateKmLegacyCefRoyalAtPokemonIdentity"
                 Id="KmLegacyCefRoyalAtPokemonIdentityValidated"
                 Value="1"
                 Sequence="execute"
                 After="ValidateKmLegacyCefPokemonIdentity"
                 Condition="KmLegacyCefRoyalPayloadValidated = 1 AND KMLEGACYCEFINSTALLLOCATION ~= KmLegacyCefPokemonRoot AND KMLEGACYCEFUNINSTALLCOMMAND ~= KmLegacyCefRoyalAtPokemonUninstallCommand" />
    <SetProperty Action="ValidateKmLegacyCefRoyalNestedIdentity"
                 Id="KmLegacyCefRoyalNestedIdentityValidated"
                 Value="1"
                 Sequence="execute"
                 After="ValidateKmLegacyCefRoyalAtPokemonIdentity"
                 Condition="KmLegacyCefRoyalPayloadValidated = 1 AND KMLEGACYCEFINSTALLLOCATION ~= KmLegacyCefRoyalNestedRoot AND KMLEGACYCEFUNINSTALLCOMMAND ~= KmLegacyCefRoyalNestedUninstallCommand" />
    <SetProperty Action="ValidateKmLegacyCefIdentity"
                 Id="KmLegacyCefIdentityValidated"
                 Value="1"
                 Sequence="execute"
                 After="ValidateKmLegacyCefRoyalNestedIdentity"
                 Condition="KmLegacyCefRoyalIdentityValidated = 1 OR KmLegacyCefPokemonIdentityValidated = 1 OR KmLegacyCefRoyalAtPokemonIdentityValidated = 1 OR KmLegacyCefRoyalNestedIdentityValidated = 1" />
    <SetProperty Action="DetectKmLegacyCefFolders"
                 Id="KmLegacyCefPresent"
                 Value="1"
                 Sequence="execute"
                 After="ValidateKmLegacyCefIdentity"
                 Condition="KMLEGACYCEFROYALCANONICALROOTPRESENT OR KMLEGACYCEFPOKEMONCANONICALROOTPRESENT OR KMLEGACYCEFROYALNESTEDROOTPRESENT" />
    <SetProperty Action="DetectKmLegacyCefRegistry"
                 Id="KmLegacyCefPresent"
                 Value="1"
                 Sequence="execute"
                 After="DetectKmLegacyCefFolders"
                 Condition="KMLEGACYCEFINSTALLLOCATION OR KMLEGACYCEFDISPLAYNAME OR KMLEGACYCEFPUBLISHER OR KMLEGACYCEFDISPLAYVERSION OR KMLEGACYCEFUNINSTALLCOMMAND" />
    <SetProperty Action="DetectUnvalidatedKmLegacyCef"
                 Id="KmLegacyCefUnsafe"
                 Value="1"
                 Sequence="execute"
                 After="DetectKmLegacyCefRegistry"
                 Condition="KmLegacyCefPresent AND NOT KmLegacyCefIdentityValidated" />
    <SetProperty Action="DetectUnvalidatedKmLegacyRoyalFolder"
                 Id="KmLegacyCefUnsafe"
                 Value="1"
                 Sequence="execute"
                 After="DetectUnvalidatedKmLegacyCef"
                 Condition="KMLEGACYCEFROYALCANONICALROOTPRESENT AND NOT KmLegacyCefRoyalIdentityValidated" />
    <SetProperty Action="DetectUnvalidatedKmLegacyPokemonFolder"
                 Id="KmLegacyCefUnsafe"
                 Value="1"
                 Sequence="execute"
                 After="DetectUnvalidatedKmLegacyRoyalFolder"
                 Condition="KMLEGACYCEFPOKEMONCANONICALROOTPRESENT AND NOT (KmLegacyCefPokemonIdentityValidated OR KmLegacyCefRoyalAtPokemonIdentityValidated OR KmLegacyCefRoyalNestedIdentityValidated)" />
    <SetProperty Action="DetectUnvalidatedKmLegacyNestedFolder"
                 Id="KmLegacyCefUnsafe"
                 Value="1"
                 Sequence="execute"
                 After="DetectUnvalidatedKmLegacyPokemonFolder"
                 Condition="KMLEGACYCEFROYALNESTEDROOTPRESENT AND NOT KmLegacyCefRoyalNestedIdentityValidated" />
    <CustomAction Id="BlockUnvalidatedLegacyCefInstall"
                  Error="An unrecognized Royal Sword installation or leftover folder was found. Uninstall the old app, or remove its unregistered Program Files folder, then run KM Companion Setup again." />
    <InstallExecuteSequence>
      <Custom Action="BlockUnvalidatedLegacyCefInstall"
              After="DetectUnvalidatedKmLegacyNestedFolder"
              Condition="KM_REMOVE_LEGACY = 1 AND KmLegacyCefUnsafe = 1" />
    </InstallExecuteSequence>
    <ComponentGroup Id="KmCalculatorLegacyMigrationComponents">
      <Component Id="KmCalculatorLegacyCefMigrationComponent"
                 Directory="INSTALLFOLDER"
                 Guid="deb65f11-dab3-4d6a-a15f-85f596f60e1b"
                 Bitness="always64"
                 Transitive="yes"
                 Condition="KmLegacyCefRoyalIdentityValidated = 1 OR KmLegacyCefPokemonIdentityValidated = 1 OR KmLegacyCefRoyalAtPokemonIdentityValidated = 1 OR KmLegacyCefRoyalNestedIdentityValidated = 1">
        <util:RemoveFolderEx Id="RemoveValidatedLegacyCefRoyalInstallRoot"
                             Property="KmLegacyCefRoyalRoot"
                             On="install"
                             Condition="KmLegacyCefRoyalIdentityValidated = 1" />
        <util:RemoveFolderEx Id="RemoveValidatedLegacyCefPokemonInstallRoot"
                             Property="KmLegacyCefPokemonRoot"
                             On="install"
                             Condition="KmLegacyCefPokemonIdentityValidated = 1 OR KmLegacyCefRoyalAtPokemonIdentityValidated = 1" />
        <util:RemoveFolderEx Id="RemoveValidatedLegacyCefRoyalNestedInstallRoot"
                             Property="KmLegacyCefRoyalNestedRoot"
                             On="install"
                             Condition="KmLegacyCefRoyalNestedIdentityValidated = 1" />
        <RemoveFolder Id="RemoveEmptyValidatedLegacyCefPokemonParent"
                      Directory="LegacyPokemonRoyalSwordProgramFilesFolder"
                      On="install" />
        <RemoveRegistryKey Id="RemoveLegacyCefProductKey"
                           Root="HKLM"
                           Key="Software\cef17072-1d18-5c82-9672-1f987b4e4970"
                           Action="removeOnInstall" />
        <RemoveRegistryKey Id="RemoveLegacyCefArpKey"
                           Root="HKLM"
                           Key="Software\Microsoft\Windows\CurrentVersion\Uninstall\cef17072-1d18-5c82-9672-1f987b4e4970"
                           Action="removeOnInstall" />
        <RegistryValue Root="HKLM"
                       Key="Software\KM Calculator"
                       Name="MigratedLegacyCef17072"
                       Value="1"
                       Type="integer"
                       KeyPath="yes" />
      </Component>
      <Component Id="KmCalculatorLegacyShortcutCleanupComponent"
                 Directory="INSTALLFOLDER"
                 Guid="efafc760-66b7-48ea-9cd4-7e890c6f144c"
                 Bitness="always64"
                 Transitive="yes"
                 Condition="KM_REMOVE_LEGACY = 1">
        <RemoveFile Id="RemoveOrphanedLegacyRoyalSwordDesktopShortcut"
                    Directory="DesktopFolder"
                    Name="Royal Sword Calculator.lnk"
                    On="install" />
        <RemoveFile Id="RemoveOrphanedLegacyPokemonRoyalSwordDesktopShortcut"
                    Directory="DesktopFolder"
                    Name="Pokemon Royal Sword.lnk"
                    On="install" />
        <RemoveFile Id="RemoveOrphanedLegacyRoyalSwordStartMenuShortcut"
                    Directory="ProgramMenuFolder"
                    Name="Royal Sword Calculator.lnk"
                    On="install" />
        <RemoveFile Id="RemoveOrphanedLegacyPokemonRoyalSwordStartMenuShortcut"
                    Directory="ProgramMenuFolder"
                    Name="Pokemon Royal Sword.lnk"
                    On="install" />
        <RemoveFile Id="RemoveOrphanedNestedLegacyRoyalSwordShortcut"
                    Directory="LegacyRoyalSwordStartMenuFolder"
                    Name="Royal Sword Calculator.lnk"
                    On="install" />
        <RemoveFile Id="RemoveOrphanedNestedLegacyPokemonRoyalSwordShortcut"
                    Directory="LegacyPokemonRoyalSwordStartMenuFolder"
                    Name="Pokemon Royal Sword.lnk"
                    On="install" />
        <RemoveFolder Id="RemoveOrphanedLegacyRoyalSwordStartMenuFolder"
                      Directory="LegacyRoyalSwordStartMenuFolder"
                      On="install" />
        <RemoveFolder Id="RemoveOrphanedLegacyPokemonRoyalSwordStartMenuFolder"
                      Directory="LegacyPokemonRoyalSwordStartMenuFolder"
                      On="install" />
        <RegistryValue Root="HKLM"
                       Key="Software\KM Calculator"
                       Name="LegacyShortcutCleanupRevision"
                       Value="1"
                       Type="integer"
                       KeyPath="yes" />
      </Component>
      <Component Id="KmCalculatorLegacyCleanupReceiptComponent"
                 Directory="INSTALLFOLDER"
                 Guid="15a40ddd-09bb-482c-a6c1-0049ce7011be"
                 Bitness="always64"
                 Condition="KM_LEGACY_CLEANUP_RECEIPT AND KM_LEGACY_CLEANUP_OWNER_SID">
        <RegistryValue Root="HKLM"
                       Key="Software\KM Calculator"
                       Name="LegacyCleanupReceipt"
                       Value="[KM_LEGACY_CLEANUP_RECEIPT]"
                       Type="string"
                       KeyPath="yes" />
        <RegistryValue Root="HKLM"
                       Key="Software\KM Calculator"
                       Name="LegacyCleanupOwnerSid"
                       Value="[KM_LEGACY_CLEANUP_OWNER_SID]"
                       Type="string" />
      </Component>
    </ComponentGroup>
  </Fragment>
</Wix>
