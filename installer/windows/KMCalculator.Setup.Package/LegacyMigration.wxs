    <!-- Searches are public MSI properties. Clear caller values before the server search. -->
    <!-- KmUndefinedSearchValue is deliberately never defined; formatting it clears a property. -->
    <SetProperty Action="ClearKmLegacyCefRoyalCanonicalRootPresent" Id="KMLEGACYCEFROYALCANONICALROOTPRESENT" Value="[KmUndefinedSearchValue]" Sequence="execute" Before="AppSearch" />
