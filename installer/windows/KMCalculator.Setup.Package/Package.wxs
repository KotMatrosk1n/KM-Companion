<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util">
  <Package Name="KM Companion"
           Manufacturer="Matroskin"
           Version="$(var.KmVersion)"
           UpgradeCode="9971df03-d3bd-4fb5-a51b-d975985eea2c"
           Scope="perMachine"
           InstallerVersion="500"
           Language="1033"
           Compressed="yes">
    <SummaryInformation Description="KM Companion desktop application"
                        Manufacturer="Matroskin" />
    <MajorUpgrade DowngradeErrorMessage="A newer version of KM Companion is already installed."
                  Schedule="afterInstallInitialize" />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <Icon Id="KmCalculatorProductIcon.ico" SourceFile="$(var.KmIconPath)" />
    <Property Id="ARPPRODUCTICON" Value="KmCalculatorProductIcon.ico" />
    <Property Id="ARPHELPLINK" Value="https://github.com/KotMatrosk1n/KM-Companion" />
    <Property Id="ARPURLINFOABOUT" Value="https://github.com/KotMatrosk1n/KM-Companion" />
    <Property Id="ARPCOMMENTS" Value="A Pokemon companion for damage calculations, encounter tracking, and run planning." />
    <Property Id="MSIRESTARTMANAGERCONTROL" Value="Disable" />

    <Property Id="KM_CREATE_DESKTOP_SHORTCUT" Value="1" Secure="yes" />
    <Property Id="KM_CREATE_START_MENU_SHORTCUT" Value="1" Secure="yes" />
    <Property Id="KM_LEGACY_CEF_VALID" Value="0" Secure="yes" />
    <Property Id="KM_REMOVE_LEGACY" Value="0" Secure="yes" />
    <Property Id="KM_LEGACY_CLEANUP_RECEIPT" Secure="yes" Hidden="yes" />
    <Property Id="KM_LEGACY_CLEANUP_OWNER_SID" Secure="yes" Hidden="yes" />
    <Property Id="KM_EXISTING_LEGACY_CLEANUP_RECEIPT" Hidden="yes">
      <RegistrySearch Id="KmExistingLegacyCleanupReceiptSearch"
                      Root="HKLM"
                      Key="Software\KM Calculator"
                      Name="LegacyCleanupReceipt"
                      Type="raw"
                      Bitness="always64" />
    </Property>
    <Property Id="KM_EXISTING_LEGACY_CLEANUP_OWNER_SID" Hidden="yes">
      <RegistrySearch Id="KmExistingLegacyCleanupOwnerSidSearch"
                      Root="HKLM"
                      Key="Software\KM Calculator"
                      Name="LegacyCleanupOwnerSid"
                      Type="raw"
                      Bitness="always64" />
    </Property>
    <SetProperty Action="PreserveKmLegacyCleanupReceipt"
                 Id="KM_LEGACY_CLEANUP_RECEIPT"
                 Value="[KM_EXISTING_LEGACY_CLEANUP_RECEIPT]"
                 Sequence="execute"
                 After="AppSearch"
                 Condition="NOT KM_LEGACY_CLEANUP_RECEIPT AND KM_EXISTING_LEGACY_CLEANUP_RECEIPT" />
    <SetProperty Action="PreserveKmLegacyCleanupOwnerSid"
                 Id="KM_LEGACY_CLEANUP_OWNER_SID"
                 Value="[KM_EXISTING_LEGACY_CLEANUP_OWNER_SID]"
                 Sequence="execute"
                 After="PreserveKmLegacyCleanupReceipt"
                 Condition="NOT KM_LEGACY_CLEANUP_OWNER_SID AND KM_EXISTING_LEGACY_CLEANUP_OWNER_SID" />

    <SetProperty Action="ClearExistingKmLegacyCleanupReceipt"
                 Id="KM_EXISTING_LEGACY_CLEANUP_RECEIPT"
                 Value="[KmUndefinedSearchValue]"
                 Sequence="execute"
                 Before="AppSearch" />
    <SetProperty Action="ClearExistingKmLegacyCleanupOwnerSid"
                 Id="KM_EXISTING_LEGACY_CLEANUP_OWNER_SID"
                 Value="[KmUndefinedSearchValue]"
                 Sequence="execute"
                 Before="AppSearch" />
    <!-- Legacy evidence is collected afresh in the server sequence, not transferred from UI. -->
    <InstallUISequence>
      <AppSearch Suppress="yes" />
    </InstallUISequence>

    <SetProperty Action="SetKmCanonicalInstallFolder"
                 Id="KmCanonicalInstallFolder"
                 Value="[ProgramFiles64Folder]KM Companion\"
                 Sequence="execute"
                 After="CostFinalize" />
    <CustomAction Id="RejectNoncanonicalKmInstallFolder"
                  Error="KM Companion must be installed in the 64 bit Program Files\KM Companion folder. Custom installation locations are not supported." />
    <InstallExecuteSequence>
      <AppSearch Sequence="100" />
      <LaunchConditions Sequence="200" />
      <Custom Action="RejectNoncanonicalKmInstallFolder"
              After="SetKmCanonicalInstallFolder"
              Condition="NOT (REMOVE ~= &quot;ALL&quot;) AND NOT INSTALLFOLDER ~= KmCanonicalInstallFolder" />
    </InstallExecuteSequence>

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="KM Companion" />
      <Directory Id="LegacyPokemonRoyalSwordProgramFilesFolder" Name="Pokemon Royal Sword" />
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="KmCalculatorStartMenuFolder" Name="KM Companion" />
      <Directory Id="LegacyRoyalSwordStartMenuFolder" Name="Royal Sword Calculator" />
      <Directory Id="LegacyPokemonRoyalSwordStartMenuFolder" Name="Pokemon Royal Sword" />
    </StandardDirectory>
    <StandardDirectory Id="DesktopFolder" />

    <util:CloseApplication Id="CloseKmCalculator"
                           Target="KM Companion.exe"
                           Description="KM Companion must close before setup can continue."
                           PromptToContinue="yes"
                           CloseMessage="yes"
                           ElevatedCloseMessage="yes"
                           EndSessionMessage="yes"
                           ElevatedEndSessionMessage="yes"
                           Timeout="10"
                           RebootPrompt="yes" />
    <util:CloseApplication Id="ClosePreviousKmCalculator"
                           Target="KM Calculator.exe"
                           Description="KM Calculator must close before it can be updated to KM Companion."
                           PromptToContinue="yes"
                           CloseMessage="yes"
                           ElevatedCloseMessage="yes"
                           EndSessionMessage="yes"
                           ElevatedEndSessionMessage="yes"
                           Timeout="10"
                           RebootPrompt="yes" />
    <util:CloseApplication Id="CloseLegacyRoyalSwordCalculator"
                           Target="Royal Sword Calculator.exe"
                           Description="Royal Sword Calculator must close before setup can continue."
                           Condition="KM_REMOVE_LEGACY = 1"
                           PromptToContinue="yes"
                           CloseMessage="yes"
                           ElevatedCloseMessage="yes"
                           Timeout="10"
                           RebootPrompt="yes" />
    <util:CloseApplication Id="CloseLegacyPokemonRoyalSword"
                           Target="Pokemon Royal Sword.exe"
                           Description="Pokemon Royal Sword must close before setup can continue."
                           Condition="KM_REMOVE_LEGACY = 1"
                           PromptToContinue="yes"
                           CloseMessage="yes"
                           ElevatedCloseMessage="yes"
                           Timeout="10"
                           RebootPrompt="yes" />

    <Feature Id="KmCalculatorFeature" Title="KM Companion" Level="1">
      <ComponentGroupRef Id="KmCalculatorPayloadComponents" />
      <ComponentGroupRef Id="KmCalculatorRegistrationComponents" />
      <ComponentGroupRef Id="KmCalculatorShortcutComponents" />
      <ComponentGroupRef Id="KmCalculatorLegacyMigrationComponents" />
    </Feature>
  </Package>
</Wix>
