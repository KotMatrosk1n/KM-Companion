{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/KotMatrosk1n/KM-Companion/blob/master/docs/schemas/trainer-pack-v1.schema.json",
  "title": "KM Companion Trainer Pack",
  "type": "object",
  "required": ["schema", "schemaVersion", "id", "name", "version", "authors", "source", "license", "trainers"],
  "properties": {
    "schema": {"const": "km-calculator.trainer-pack"},
    "schemaVersion": {"const": 1},
    "id": {"type": "string", "minLength": 1},
    "name": {"type": "string", "minLength": 1},
    "version": {"type": "string", "minLength": 1},
    "profileId": {"type": "string", "minLength": 1},
    "generation": {"type": "integer", "minimum": 1, "maximum": 9},
    "generations": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "integer", "minimum": 1, "maximum": 9}
    },
    "game": {"type": "string"},
    "mod": {"type": "string"},
    "description": {"type": "string"},
    "authors": {
      "type": "array",
      "minItems": 1,
      "items": {
        "oneOf": [
          {"type": "string", "minLength": 1},
          {
            "type": "object",
            "required": ["name"],
            "properties": {
              "name": {"type": "string", "minLength": 1},
              "url": {"type": "string", "format": "uri"}
            }
          }
        ]
      }
    },
    "source": {
      "type": "object",
      "required": ["name", "url"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "url": {"type": "string", "format": "uri"},
        "notes": {"type": "string"}
      }
    },
    "license": {"type": "string", "minLength": 1},
    "trainers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "pokemon"],
        "properties": {
          "id": {"type": "string"},
          "area": {"type": "string"},
          "name": {"type": "string", "minLength": 1},
          "battleType": {"enum": ["Single", "Double", "single", "double"]},
          "generation": {"type": "integer", "minimum": 1, "maximum": 9},
          "generations": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"type": "integer", "minimum": 1, "maximum": 9}
          },
          "variant": {"type": "string"},
          "pokemon": {
            "type": "array",
            "minItems": 1,
            "maxItems": 6,
            "items": {
              "type": "object",
              "required": ["species"],
              "properties": {
                "slot": {"type": "integer", "minimum": 1, "maximum": 6},
                "species": {"type": "string", "minLength": 1},
                "nickname": {"type": "string"},
                "level": {"type": "integer", "minimum": 1, "maximum": 100},
                "gender": {"enum": ["M", "F", "N"]},
                "ability": {"type": "string"},
                "item": {"type": "string"},
                "nature": {"type": "string"},
                "teraType": {"type": "string"},
                "moves": {
                  "type": "array",
                  "maxItems": 4,
                  "items": {"type": "string", "minLength": 1}
                },
                "ivs": {"$ref": "#/$defs/ivs"},
                "dvs": {"$ref": "#/$defs/dvs"},
                "evs": {"$ref": "#/$defs/evs"}
              }
            }
          }
        }
      }
    }
  },
  "oneOf": [
    {"required": ["generation"]},
    {"required": ["generations"]}
  ],
  "$defs": {
    "ivs": {"$ref": "#/$defs/ivStatMap"},
    "dvs": {"$ref": "#/$defs/dvStatMap"},
    "evs": {"$ref": "#/$defs/evStatMap"},
    "ivStatMap": {
      "type": "object",
      "propertyNames": {"enum": ["hp", "at", "atk", "df", "def", "sl", "spc", "sa", "spa", "sd", "spd", "sp", "spe"]},
      "additionalProperties": {"type": "integer", "minimum": 0, "maximum": 31}
    },
    "dvStatMap": {
      "type": "object",
      "propertyNames": {"enum": ["hp", "at", "atk", "df", "def", "sl", "spc", "sa", "spa", "sd", "spd", "sp", "spe"]},
      "additionalProperties": {"type": "integer", "minimum": 0, "maximum": 15}
    },
    "evStatMap": {
      "type": "object",
      "propertyNames": {"enum": ["hp", "at", "atk", "df", "def", "sl", "spc", "sa", "spa", "sd", "spd", "sp", "spe"]},
      "additionalProperties": {"type": "integer", "minimum": 0, "maximum": 252}
    }
  }
}
