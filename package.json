{
  "name": "km-companion",
  "productName": "KM Companion",
  "version": "0.0.1",
  "description": "A Pokemon companion for damage calculations, encounter tracking, and run planning.",
  "private": true,
  "main": "electron/main.js",
  "homepage": "https://github.com/KotMatrosk1n/KM-Companion",
  "repository": "github:KotMatrosk1n/KM-Companion",
  "author": "Matroskin",
  "license": "GPL-3.0-only",
  "copyright": "Copyright 2026 Matroskin",
  "devDependencies": {
    "ajv": "6.15.0",
    "electron": "^42.11.16",
    "electron-builder": "^26.15.0",
    "electron-winstaller": "5.4.0",
    "eslint": "^8.57.0",
    "js-yaml": "4.3.2",
    "subpkg": "^4.1.0"
  },
  "scripts": {
    "lint": "subpkg run lint && eslint --cache src --ext js && eslint --cache electron --ext js",
    "fix": "subpkg run fix && eslint --fix src --ext js && eslint --fix electron --ext js",
    "compile": "subpkg run compile && node build view",
    "build": "subpkg run build && node build view",
    "build-ui": "node build view",
    "generate:swsh-ai": "node scripts/generate-swsh-ai-data.mjs",
    "sprites:download": "node electron/download-sprites.js",
    "electron:dev": "npm run build && npm run sprites:download && electron .",
    "electron:pack": "npm run build && npm run sprites:download && electron-builder --win --dir",
    "electron:dist": "npm run electron:pack && pwsh -NoProfile -File installer/windows/scripts/Build-KmCalculatorWindowsSetup.ps1",
    "generate:third-party-notices": "node scripts/generate-third-party-notices.mjs",
    "check:third-party-notices": "node scripts/generate-third-party-notices.mjs --check",
    "release:source": "node scripts/package-release-source.mjs",
    "check:workspace": "node scripts/check-workspace-paths.mjs",
    "postinstall": "subpkg install",
    "validate:mod": "node scripts/validate-mod-submission.mjs"
  },
  "build": {
    "appId": "com.kotmatrosk1n.kmcalculator",
    "productName": "KM Companion",
    "copyright": "Copyright 2026 Matroskin",
    "extraMetadata": {
      "project": "KM Companion",
      "creator": "Matroskin",
      "repository": "KotMatrosk1n/KM-Companion"
    },
    "afterPack": "electron/after-pack.js",
    "directories": {
      "output": "release"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "KotMatrosk1n",
        "repo": "KM-Companion"
      }
    ],
    "files": [
      "dist/**/*",
      "electron/**/*",
      "!electron/.eslintrc",
      "!electron/after-pack.js",
      "!electron/assets/km-companion-icon.ico",
      "!electron/download-sprites.js",
      "!electron/sprites/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "dist/licenses",
        "to": "licenses",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "dist/licenses/node_modules",
        "to": "licenses/node_modules",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "electron/sprites",
        "to": "sprites",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "icon": "electron/assets/km-companion-icon.ico",
      "signAndEditExecutable": false
    }
  },
  "subPackages": [
    "calc"
  ],
  "dependencies": {
    "builder-util-runtime": "9.7.0",
    "electron-updater": "^6.8.9"
  },
  "overrides": {
    "@electron/get@3.1.0": {
      "global-agent": "^4.1.3"
    }
  },
  "kmCompanion": {
    "project": "KM Companion",
    "creator": "Matroskin",
    "repository": "KotMatrosk1n/KM-Companion"
  }
}
